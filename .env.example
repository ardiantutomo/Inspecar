# Salin ke .env lalu sesuaikan. Semua nilai di bawah punya default yang aman untuk
# development lokal — app tetap jalan penuh tanpa API LLM & tanpa payment gateway.

# --- Database (SQLite untuk dev; ganti ke Postgres saat produksi) ---
DATABASE_URL="file:./data/dev.db"

# --- Sesi ---
# Wajib diisi di produksi. Buat dengan: openssl rand -hex 32
SESSION_SECRET="ganti-dengan-string-acak-panjang-di-produksi"

# --- Penyimpanan foto inspeksi ---
DATA_DIR="./data"

# --- Alamat publik app (dipakai untuk share link report) ---
APP_URL="http://localhost:3000"

# --- Freemium ---
REPORT_PRICE_IDR="29000"
# "mock" = checkout simulasi tanpa gateway. Ganti saat integrasi Midtrans/Xendit.
PAYMENT_MODE="mock"

# --- LLM (opsional) ---
# Tanpa API key: checklist Tier A tetap jalan, Tier B dilewati, narasi report
# memakai generator berbasis aturan. Endpoint apa pun yang kompatibel
# OpenAI Chat Completions bisa dipakai.
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"

# --- Akses halaman kurasi (/kurasi), dipisah koma ---
ADMIN_EMAILS=""
